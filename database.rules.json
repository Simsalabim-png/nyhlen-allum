{
  "rules": {
    ".read": false,
    ".write": false,
    "access": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "todo": {
      ".read": "auth != null && root.child('access').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('access').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['text','done','createdAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().length > 0"
        },
        "done": {
          ".validate": "newData.isBoolean()"
        },
        "member": {
          ".validate": "newData.isString() && (newData.val() === '' || root.child('members').child(newData.val()).exists())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "shopping": {
      ".read": "auth != null && root.child('access').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('access').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['text','done','createdAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().length > 0"
        },
        "done": {
          ".validate": "newData.isBoolean()"
        },
        "member": {
          ".validate": "newData.isString() && (newData.val() === '' || root.child('members').child(newData.val()).exists())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "events": {
      ".read": "auth != null && root.child('access').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('access').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['title','date','members','repeat','updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().length > 0"
        },
        "notes": {
          ".validate": "newData.isString() && newData.val().length <= 5000"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "endDate": {
          ".validate": "newData.isString() && (newData.val() === '' || (newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.val() >= newData.parent().child('date').val()))"
        },
        "start": {
          ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-3]):[0-5][0-9])?$/)"
        },
        "end": {
          ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-3]):[0-5][0-9])?$/)"
        },
        "repeat": {
          ".validate": "newData.val() === 'ingen' || newData.val() === 'daglig' || newData.val() === 'ukentlig' || newData.val() === 'manedlig' || newData.val() === 'arlig'"
        },
        "reminder": {
          ".validate": "newData.val() === 0 || newData.val() === 5 || newData.val() === 60 || newData.val() === 120 || newData.val() === 1440"
        },
        "members": {
          ".validate": "newData.hasChildren()",
          "$index": {
            ".validate": "$index.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && root.child('members').child(newData.val()).exists()"
          }
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "remindedFor": {
          ".validate": "newData.val() === data.val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "members": {
      ".read": "auth != null && root.child('access').child(auth.uid).val() === true",
      "$name": {
        ".write": "auth != null && root.child('access').child(auth.uid).val() === true",
        ".validate": "$name.length <= 40 && newData.hasChildren(['color','order'])",
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "order": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
